rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['email']) && data.email is string && data.email.size() > 0 && data.email.size() <= 200;
    }

    function isValidIncident(data) {
      return data.keys().hasAll(['title', 'problem', 'analysis', 'userId']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 500 &&
             data.problem is string && data.problem.size() <= 5000 &&
             data.analysis is string && data.analysis.size() <= 20000;
    }

    function isValidTelemetry(data) {
      return data.keys().hasAll(['userId', 'timestamp', 'latencyMs', 'queryType', 'status']) &&
             data.userId == request.auth.uid &&
             data.latencyMs is number &&
             data.timestamp is number &&
             data.queryType is string && data.queryType.size() <= 100 &&
             data.status is string && data.status.size() <= 50;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId) && resource.data.id == request.auth.uid; // This logic enforces list, though id might not exist here. better to use get.
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'name']);
      allow delete: if false;
    }

    match /archives/{archiveId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidIncident(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /telemetry/{telemetryId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidTelemetry(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }
  }
}
